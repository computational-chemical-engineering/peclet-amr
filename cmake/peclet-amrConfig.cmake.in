# peclet-amr package config: `find_package(peclet-amr CONFIG)` -> peclet::amr (header-only; needs
# Kokkos and MPI; the peclet-core and morton headers are supplied by
# the consumer — they are BUILD_INTERFACE-only here). Generated from cmake/peclet-amrConfig.cmake.in.
@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
