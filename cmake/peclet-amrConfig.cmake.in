# peclet-amr package config: `find_package(peclet-amr CONFIG)` -> peclet::amr (header-only; needs
# Kokkos and, when built with PECLET_AMR_MPI, MPI; the peclet-core and morton headers are supplied by
# the consumer — they are BUILD_INTERFACE-only here). Generated from cmake/peclet-amrConfig.cmake.in.
@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Kokkos CONFIG)
if(@PECLET_AMR_MPI@)
  find_dependency(MPI COMPONENTS CXX)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/peclet-amrTargets.cmake")
check_required_components(peclet-amr)
